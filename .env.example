# Hindsight extraction model (required). Any OpenAI-compatible provider works.
# DeepSeek (current machine):
HINDSIGHT_API_LLM_PROVIDER=deepseek
HINDSIGHT_API_LLM_MODEL=deepseek-v4-pro
HINDSIGHT_API_LLM_API_KEY=
# Or OpenAI:
# HINDSIGHT_API_LLM_PROVIDER=openai
# HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
# Optional: point at a compatible gateway.
# HINDSIGHT_API_LLM_BASE_URL=

# Hugging Face mirror for the local embedding model. Mainland China usually
# needs hf-mirror.com; set to https://huggingface.co when direct access works.
HF_ENDPOINT=https://hf-mirror.com
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=BAAI/bge-small-zh-v1.5

# SiliconFlow speech-to-text (required for the specified iPhone microphone ASR).
SILICONFLOW_API_KEY=

# Optional: protect Hindsight itself with a bearer token. Keep this out of git.
HINDSIGHT_API_KEY=
